# =============================================================================
# SCALPAI PRODUCTION CONFIGURATION
# Copy this file to .env and fill in your real values
# =============================================================================

# --- API Credentials (REQUIRED - from metatraderapi.net dashboard) ---
MTAPI_KEY=mt5api_your_api_key_here
MTAPI_ACCOUNT_ID=your_account_uuid_here
MTAPI_BASE_URL=https://api.metatraderapi.net

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# --- Database (Supabase PostgreSQL) ---
# Option A: Provide full DATABASE_URL directly
# DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require

# Option B: Or provide Supabase URL + password separately (build DATABASE_URL automatically)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_DB_PASSWORD=your_supabase_db_password_here

DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# --- Redis (Upstash or Redis Cloud) ---
REDIS_URL=redis://default:[password]@[host]:[port]
REDIS_CACHE_TTL=60

# --- Risk ---
DEFAULT_BALANCE=10000.0
DEFAULT_TARGET_PCT=0.02
DEFAULT_MAX_LOSS_PCT=0.01
DEFAULT_RISK_PER_TRADE_PCT=0.015
DEFAULT_SL_PIPS=150
DEFAULT_TP_PIPS=300
DEFAULT_LOT_SIZE=0.01
MAX_DAILY_TRADES=50
MAX_POSITIONS_PER_SYMBOL=1
MAX_SYMBOLS=5

# --- Symbols to trade ---
SYMBOLS=EURUSD,GBPUSD,USDJPY,GOLD

# --- Security ---
API_KEY_HEADER=X-API-Key
RATE_LIMIT_PER_MINUTE=60
